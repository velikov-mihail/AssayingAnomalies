# Virtual environments
.venv/
venv/

# A project folder inside a clone: the database, extracts and outputs are
# built from licensed data and never belong in the repository. The leading
# slash matters: on a case-insensitive file system (macOS, Windows) a bare
# "Data/" also ignores src/assayinganomalies/ingest/data/, which holds the
# packaged Compustat variable list.
/Data/
/Scratch/

